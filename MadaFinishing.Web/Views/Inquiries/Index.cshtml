@using System.Globalization
@model InquiryListViewModel
@{
    ViewData["Title"] = "الاستفسارات";
    var statusLabels = Html.GetEnumSelectList<InquiryStatus>();
}

<section class="dashboard-heading rounded-4 overflow-hidden mb-4" aria-labelledby="dashboard-title">
    <div class="row g-0">
        <div class="col-md-7 p-4 p-lg-5">
            <h1 id="dashboard-title" class="display-6 fw-bold mb-2">الاستفسارات</h1>
            <p class="mb-4 text-white text-opacity-75">ابحث عن استفسار أو تابع حالته والمسؤول عنه.</p>
            @if (User.IsInRole(StaffUser.ManagerRole))
            {
                <a asp-action="Create" class="btn btn-light fw-semibold px-4">
                    <span class="me-1" aria-hidden="true">+</span> استفسار جديد
                </a>
            }
        </div>
        <div class="col-md-5 finishing-photo dashboard-photo" aria-hidden="true"></div>
    </div>
</section>

<section class="card bg-white border-0 rounded-4 shadow-sm mb-4" aria-labelledby="search-title">
    <div class="card-body p-3 p-md-4">
        <h2 id="search-title" class="h5 fw-bold mb-3">البحث والتصفية</h2>
        <form id="inquiry-search" asp-action="Index" method="get" role="search">
            <input name="Status" type="hidden" value="@((int?)Model.Status)" />
            <div class="row g-2 align-items-end">
                <div class="col-sm">
                    <label asp-for="Search" class="form-label fw-semibold">اسم العميل أو رقم الهاتف</label>
                    <input asp-for="Search" type="search" class="form-control" />
                </div>
                <div class="col-sm-auto d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary px-4">بحث</button>
                    <a id="inquiry-search-reset" asp-action="Index"
                       class="btn btn-outline-secondary @(string.IsNullOrWhiteSpace(Model.Search) && Model.Status is null ? "d-none" : null)">مسح البحث</a>
                </div>
            </div>
        </form>
        <nav id="inquiry-status-filters" class="nav nav-pills gap-2 mt-3 status-filters" aria-label="تصفية حسب الحالة">
            <a asp-action="Index" asp-route-search="@Model.Search"
               class="nav-link @(Model.Status is null ? "active" : null)"
               aria-current="@(Model.Status is null ? "page" : null)">كل الحالات</a>
            @foreach (var status in statusLabels)
            {
                var isSelected = status.Value == ((int?)Model.Status)?.ToString(CultureInfo.InvariantCulture);
                <a asp-action="Index" asp-route-status="@status.Value" asp-route-search="@Model.Search"
                   class="nav-link @(isSelected ? "active" : null)"
                   aria-current="@(isSelected ? "page" : null)">@status.Text</a>
            }
        </nav>
    </div>
</section>

<p id="inquiry-search-notice" class="small mb-2 visually-hidden" role="status"></p>
<partial name="_InquiryResults" model="Model" />

@section Scripts {
    <script src="~/js/inquiry-search.js" asp-append-version="true" defer></script>
}
