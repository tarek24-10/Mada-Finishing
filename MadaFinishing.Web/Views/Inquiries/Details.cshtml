@using System.Globalization
@model InquiryDetailsViewModel
@{
    ViewData["Title"] = "تفاصيل الاستفسار";
    var culture = CultureInfo.GetCultureInfo("ar-EG");
    var cairo = TimeZoneInfo.FindSystemTimeZoneById("Africa/Cairo");
    var createdInCairo = TimeZoneInfo.ConvertTime(Model.CreatedAt, cairo);
    var statusLabels = Html.GetEnumSelectList<InquiryStatus>();
    string StatusLabel(InquiryStatus status) =>
        statusLabels.First(item => item.Value == ((int)status).ToString(CultureInfo.InvariantCulture)).Text;
    var nextStatus = Inquiry.NextStatusAfter(Model.Status);
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <h1 class="h2 fw-bold text-break mb-0">@Model.CustomerName</h1>
    <a asp-action="Index" class="btn btn-outline-primary">العودة إلى الاستفسارات</a>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-7">
        <section class="card card-body bg-white border-0 rounded-4 shadow-sm p-4 mb-4" aria-labelledby="inquiry-details">
            <h2 id="inquiry-details" class="h5 fw-bold mb-3">تفاصيل الاستفسار</h2>
            <dl class="row g-2 mb-0">
                <dt class="col-sm-4 text-body-secondary fw-medium">رقم الهاتف</dt>
                <dd class="col-sm-8"><bdi dir="ltr">@Model.Phone</bdi></dd>
                <dt class="col-sm-4 text-body-secondary fw-medium">نوع الخدمة</dt>
                <dd class="col-sm-8">@Model.ServiceType</dd>
                <dt class="col-sm-4 text-body-secondary fw-medium">تاريخ الإدخال</dt>
                <dd class="col-sm-8">
                    <time datetime="@createdInCairo.ToString("O", CultureInfo.InvariantCulture)">
                        @createdInCairo.ToString("dd MMM yyyy، HH:mm", culture)
                    </time>
                </dd>
                <dt class="col-sm-4 text-body-secondary fw-medium">الحالة</dt>
                <dd class="col-sm-8"><partial name="_InquiryStatusBadge" model="Model.Status" /></dd>
                <dt class="col-sm-4 text-body-secondary fw-medium">المسؤول الحالي</dt>
                <dd class="col-sm-8">@(Model.CoordinatorName ?? "غير مسند")</dd>
                @if (Model.Message is not null)
                {
                    <dt class="col-sm-4 text-body-secondary fw-medium">رسالة العميل</dt>
                    <dd class="col-sm-8 text-break">@Model.Message</dd>
                }
            </dl>
        </section>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
        @if (User.IsInRole(StaffUser.ManagerRole) && Model.Status != InquiryStatus.Closed)
        {
            <section class="card card-body bg-white border-0 rounded-4 shadow-sm p-4" aria-labelledby="assign-coordinator">
                <h2 id="assign-coordinator" class="h5 fw-bold mb-3">إسناد الاستفسار</h2>
                @if (Model.Coordinators.Count == 0)
                {
                    <p class="text-body-secondary mb-0">لا توجد حسابات لمنسقي المبيعات.</p>
                }
                else
                {
                    <form asp-action="Assign" asp-route-id="@Model.Id" method="post" novalidate
                          class="d-flex flex-wrap align-items-end gap-3">
                        <div class="flex-grow-1">
                            <label for="coordinatorId" class="form-label fw-semibold">منسق المبيعات</label>
                            <select name="coordinatorId" id="coordinatorId" class="form-select" required>
                                <option value="">اختر منسقًا</option>
                                @foreach (var coordinator in Model.Coordinators)
                                {
                                    <option value="@coordinator.Id" selected="@(coordinator.Id == Model.CoordinatorId)">@coordinator.DisplayName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">حفظ الإسناد</button>
                    </form>
                }
            </section>
        }

        @if (User.IsInRole(StaffUser.CoordinatorRole) && !User.IsInRole(StaffUser.ManagerRole) &&
             Model.Status != InquiryStatus.Closed)
        {
            <section class="card card-body bg-white border-0 rounded-4 shadow-sm p-4" aria-labelledby="follow-up">
                <h2 id="follow-up" class="h5 fw-bold mb-3">متابعة الاستفسار</h2>
                <form asp-action="AddNote" asp-route-id="@Model.Id" method="post" novalidate class="mb-4">
                    <label for="note" class="form-label fw-semibold">ملاحظة المتابعة</label>
                    <textarea id="note" name="note" class="form-control mb-3" rows="3"
                              maxlength="@InquiryFollowUp.NoteMaxLength" required>@Model.Note</textarea>
                    <button type="submit" class="btn btn-primary">حفظ الملاحظة</button>
                </form>
                @if (nextStatus is { } next)
                {
                    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="mb-3">
                        <input type="hidden" name="status" value="@((int)next)" />
                        <button type="submit" class="btn btn-outline-primary">تغيير الحالة إلى @StatusLabel(next)</button>
                    </form>
                }
                <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" novalidate class="border-top pt-3">
                    <input type="hidden" name="status" value="@((int)InquiryStatus.Closed)" />
                    <label for="reason" class="form-label fw-semibold">سبب الإغلاق</label>
                    <textarea id="reason" name="reason" class="form-control mb-3" rows="2"
                              maxlength="@InquiryFollowUp.ClosureReasonMaxLength" required>@Model.ClosureReason</textarea>
                    <button type="submit" class="btn btn-outline-danger">إغلاق الاستفسار</button>
                </form>
            </section>
        }
    </div>
    <div class="col-12 col-lg-5">
        <section class="card card-body bg-white border-0 rounded-4 shadow-sm p-4" aria-labelledby="inquiry-history">
            <h2 id="inquiry-history" class="h5 fw-bold mb-3">سجل النشاط</h2>
            @if (Model.History.Count == 0)
            {
                <p class="text-body-secondary mb-0">لا توجد أنشطة مسجلة.</p>
            }
            else
            {
                <ol class="list-group list-group-flush activity-list ms-1">
                    @foreach (var entry in Model.History)
                    {
                        var occurredInCairo = TimeZoneInfo.ConvertTime(entry.OccurredAt, cairo);
                        <li class="list-group-item bg-white ps-3 pe-0 py-3">
                            @if (entry.Kind == InquiryHistoryKind.Assignment)
                            {
                                <div class="fw-semibold">@entry.ActorName — من @(entry.PreviousCoordinatorName ?? "غير مسند") إلى @entry.NewCoordinatorName</div>
                            }
                            else if (entry.Kind == InquiryHistoryKind.Note)
                            {
                                <div class="fw-semibold">@entry.ActorName — ملاحظة متابعة</div>
                                <p class="inquiry-history-text text-break mb-1">@entry.Text</p>
                            }
                            else if (entry.PreviousStatus is { } previousStatus && entry.NewStatus is { } newStatus)
                            {
                                <div class="fw-semibold">@entry.ActorName — من @StatusLabel(previousStatus) إلى @StatusLabel(newStatus)</div>
                                @if (newStatus == InquiryStatus.Closed)
                                {
                                    <p class="text-break mb-1">سبب الإغلاق: @entry.Text</p>
                                }
                            }
                            <time class="small text-body-secondary" datetime="@occurredInCairo.ToString("O", CultureInfo.InvariantCulture)">
                                @occurredInCairo.ToString("dd MMM yyyy، HH:mm", culture)
                            </time>
                        </li>
                    }
                </ol>
            }
        </section>
    </div>
</div>
