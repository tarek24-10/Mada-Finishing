@model InquiryInput
@{
    ViewData["Title"] = "استفسار جديد";
}

<section class="card shadow-sm mx-auto" style="max-width: 44rem;">
    <div class="card-body p-4">
        <h1 class="h3 mb-4">استفسار جديد</h1>
        <form asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label"></label>
                <input asp-for="CustomerName" class="form-control" required maxlength="@Inquiry.CustomerNameMaxLength"
                       aria-describedby="customer-name-error" />
                <span asp-validation-for="CustomerName" id="customer-name-error" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" type="tel" dir="ltr" class="form-control" required maxlength="@Inquiry.PhoneMaxLength"
                       aria-describedby="phone-error" />
                <span asp-validation-for="Phone" id="phone-error" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ServiceType" class="form-label"></label>
                <input asp-for="ServiceType" class="form-control" required maxlength="@Inquiry.ServiceTypeMaxLength"
                       aria-describedby="service-error" />
                <span asp-validation-for="ServiceType" id="service-error" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Message" class="form-label"></label>
                <textarea asp-for="Message" rows="4" maxlength="@Inquiry.MessageMaxLength" class="form-control"
                          aria-describedby="message-error"></textarea>
                <span asp-validation-for="Message" id="message-error" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">حفظ الاستفسار</button>
                <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
            </div>
        </form>
    </div>
</section>
