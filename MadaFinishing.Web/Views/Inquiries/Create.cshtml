@model InquiryInput
@{
    ViewData["Title"] = "استفسار جديد";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
        <div class="mb-4">
            <a asp-action="Index" class="small fw-semibold d-inline-block mb-2">العودة إلى الاستفسارات</a>
            <h1 class="h2 fw-bold mb-1">استفسار جديد</h1>
            <p class="text-body-secondary mb-0">أدخل بيانات العميل والخدمة المطلوبة.</p>
        </div>
        <section class="card card-body bg-white border-0 rounded-4 shadow-sm p-4 p-lg-5" aria-label="بيانات الاستفسار">
            <form asp-action="Create" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                    <input asp-for="CustomerName" class="form-control" required maxlength="@Inquiry.CustomerNameMaxLength"
                           aria-describedby="customer-name-error" />
                    <span asp-validation-for="CustomerName" id="customer-name-error" class="small text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Phone" class="form-label fw-semibold"></label>
                    <input asp-for="Phone" type="tel" dir="ltr" class="form-control" required maxlength="@Inquiry.PhoneMaxLength"
                           aria-describedby="phone-error" />
                    <span asp-validation-for="Phone" id="phone-error" class="small text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ServiceType" class="form-label fw-semibold"></label>
                    <input asp-for="ServiceType" class="form-control" required maxlength="@Inquiry.ServiceTypeMaxLength"
                           aria-describedby="service-error" />
                    <span asp-validation-for="ServiceType" id="service-error" class="small text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Message" class="form-label fw-semibold"></label>
                    <textarea asp-for="Message" rows="4" maxlength="@Inquiry.MessageMaxLength" class="form-control"
                              aria-describedby="message-error"></textarea>
                    <span asp-validation-for="Message" id="message-error" class="small text-danger"></span>
                </div>
                <div class="d-flex flex-wrap gap-2 border-top pt-4">
                    <button type="submit" class="btn btn-primary">حفظ الاستفسار</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                </div>
            </form>
        </section>
    </div>
</div>
