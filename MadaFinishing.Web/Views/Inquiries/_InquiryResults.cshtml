@model InquiryListViewModel

<section id="inquiry-results" data-search="@Model.Search" data-status="@((int?)Model.Status)"
         class="card bg-white border-0 rounded-4 shadow-sm" aria-labelledby="results-title">
    <div class="card-header bg-white rounded-top-4 d-flex flex-wrap align-items-center justify-content-between gap-2 p-3 p-md-4">
        <h2 id="results-title" tabindex="-1" class="h5 fw-bold mb-0">نتائج البحث</h2>
        <span id="inquiry-result-count" class="badge rounded-pill bg-light text-dark border px-3 py-2">عدد النتائج <bdi>@Model.TotalCount</bdi></span>
    </div>
    @if (Model.Inquiries.Count == 0)
    {
        <div class="card-body text-center text-body-secondary p-4 p-md-5">
            <p class="mb-0">لا توجد استفسارات مطابقة.</p>
        </div>
    }
    else
    {
        <div class="table-responsive @(Model.TotalPages <= 1 ? "rounded-bottom-4" : null)" role="region" aria-label="جدول الاستفسارات" tabindex="0">
            <table class="table table-hover align-middle mb-0 inquiry-table">
                <thead class="table-light text-nowrap">
                    <tr>
                        <th scope="col" class="ps-4 py-3">العميل</th>
                        <th scope="col">الخدمة</th>
                        <th scope="col">تاريخ الإدخال</th>
                        <th scope="col">الحالة</th>
                        <th scope="col" class="pe-4">المسؤول</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inquiry in Model.Inquiries)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <a asp-action="Details" asp-route-id="@inquiry.Id" class="fw-bold">@inquiry.CustomerName</a>
                                <div class="small text-body-secondary"><bdi dir="ltr">@inquiry.Phone</bdi></div>
                            </td>
                            <td>@inquiry.ServiceType</td>
                            <td class="small text-nowrap">
                                <partial name="_CairoTime" model="inquiry.CreatedAt" />
                            </td>
                            <td><partial name="_InquiryStatusBadge" model="inquiry.Status" /></td>
                            <td>@(inquiry.CoordinatorName ?? "غير مسند")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white rounded-bottom-4 d-flex flex-wrap align-items-center justify-content-between gap-2 p-3">
            <p id="inquiry-page-description" class="small text-body-secondary mb-0">
                الصفحة <bdi>@Model.PageNumber</bdi> من <bdi>@Model.TotalPages</bdi>
            </p>
            <nav id="inquiry-pagination" aria-label="صفحات الاستفسارات">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.PageNumber == 1 ? "disabled" : null)">
                        @if (Model.PageNumber > 1)
                        {
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-status="@((int?)Model.Status)" asp-route-pageNumber="@(Model.PageNumber - 1)">السابق</a>
                        }
                        else
                        {
                            <span class="page-link" aria-disabled="true">السابق</span>
                        }
                    </li>
                    <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : null)">
                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a class="page-link" asp-action="Index" asp-route-search="@Model.Search"
                               asp-route-status="@((int?)Model.Status)" asp-route-pageNumber="@(Model.PageNumber + 1)">التالي</a>
                        }
                        else
                        {
                            <span class="page-link" aria-disabled="true">التالي</span>
                        }
                    </li>
                </ul>
            </nav>
        </div>
    }
</section>
