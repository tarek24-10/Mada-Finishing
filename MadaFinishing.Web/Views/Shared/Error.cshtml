@model ErrorViewModel
@{
    ViewData["Title"] = "تعذّر عرض الصفحة";
}

<section class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4 p-lg-5">
        <h1 class="h3 fw-bold">تعذّر عرض الصفحة</h1>
        <p class="text-body-secondary">حدث خطأ أثناء معالجة الطلب. حاول مرة أخرى.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small">رقم الطلب <code><bdi dir="ltr">@Model.RequestId</bdi></code></p>
        }
        <a asp-controller="Inquiries" asp-action="Index" class="btn btn-outline-primary">العودة إلى الاستفسارات</a>
    </div>
</section>
