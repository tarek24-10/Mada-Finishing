<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — مدى للتشطيبات</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MadaFinishing.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header class="bg-white border-bottom">
        <nav class="container d-flex flex-wrap align-items-center justify-content-between gap-2 py-3" aria-label="التنقل الرئيسي">
            <a class="fw-bold text-decoration-none text-dark" asp-controller="Inquiries" asp-action="Index">مدى للتشطيبات</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Account" asp-action="SignOut" method="post">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">تسجيل الخروج</button>
                </form>
            }
        </nav>
    </header>
    <main class="container py-4">
        @RenderBody()
    </main>
</body>
</html>
